{
"name": "nexus-city",
"private": true,
"version": "0.1.0",
"type": "module",
"workspaces": [
"packages/*",
"apps/*",
"services/*"
],
"scripts": {
"dev": "tsx watch services/api/src/index.ts",
"build": "node scripts/build.mjs",
"typecheck": "tsc --noEmit",
"test": "tsx --test packages/engine/test/*.test.ts",
"start": "node dist/server.mjs",
"test:hw": "tsx --test tests/hardware.test.ts",
"test:engine": "tsx --test packages/engine/test/*.test.ts",
"test:board": "tsx --test tests/board.test.ts tests/board.store.test.ts tests/board.sqlstore.test.ts tests/board.gateway.test.ts"
},
"dependencies": {
"@fastify/cookie": "^11.0.2",
"@fastify/static": "^8.3.0",
"@fastify/rate-limit": "^10.3.0",
"@fastify/helmet": "^13.0.1",
"@fastify/websocket": "^11.2.0",
"@node-rs/argon2": "^2.0.2",
"fastify": "^5.6.1",
"mysql2": "^3.15.3",
"zod": "^4.1.12",
"ws": "^8.18.3",
"react": "^19.2.0",
"react-dom": "^19.2.0",
"three": "^0.180.0",
"@react-three/fiber": "^9.4.0",
"lucide-react": "^0.468.0"
},
"devDependencies": {
"@types/node": "^22.18.10",
"@types/react": "^19.2.0",
"@types/react-dom": "^19.2.0",
"@types/three": "^0.180.0",
"@types/ws": "^8.18.1",
"@vitejs/plugin-react": "^5.0.4",
"esbuild": "^0.25.11",
"tsx": "^4.20.6",
"typescript": "^5.9.3",
"vite": "^7.1.12"
}
}